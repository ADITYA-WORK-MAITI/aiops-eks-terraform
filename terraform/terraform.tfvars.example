project     = "aiops"
environment = "dev"
region      = "ap-south-1"

node_instance_types = ["t3.medium"]
node_capacity_type  = "ON_DEMAND"
node_min_size       = 2
node_desired_size   = 2
node_max_size       = 5

# Extra IAM users/roles that should get cluster-admin access.
cluster_admin_arns = []

# Enables the GitHub Actions OIDC deploy role.
github_repository = "ADITYA-WORK-MAITI/aiops-eks-terraform"
